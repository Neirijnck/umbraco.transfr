<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Serve wwwroot at the site root, so the manifest is at /App_Plugins/Transfr/umbraco-package.json (not under _content/) -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- Backoffice JS ships as-is -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Neirijnck.Transfr</PackageId>
    <Product>Transfr</Product>
    <Title>Transfr</Title>
    <Description>Compare Umbraco content and media trees between environments side by side and copy nodes and media either way, key-preserving, with a mandatory dry run.</Description>
    <VersionPrefix>17.2.0</VersionPrefix>
    <Authors>Preben Neirijnck</Authors>
    <Copyright>Preben Neirijnck</Copyright>
    <PackageTags>umbraco umbraco-marketplace content compare diff sync transfer</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Neirijnck/umbraco.transfr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Neirijnck/umbraco.transfr</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
  </ItemGroup>

  <!-- Core ships inside this package (lib/), not as a separate NuGet dependency -->
  <ItemGroup>
    <ProjectReference Include="..\Neirijnck.Transfr.Core\Neirijnck.Transfr.Core.csproj" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectReferencesInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeProjectReferencesInPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Client sources are not content; only the built output in wwwroot ships -->
    <Compile Remove="Client\**" />
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <EmbeddedResource Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="Client\src\**\*" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Build the backoffice client with npm as part of dotnet build / pack -->
  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\Client</ClientDir>
  </PropertyGroup>

  <!-- npm writes node_modules\.package-lock.json on every install: a package-lock.json newer than that (a branch
       switch to another Umbraco line, a pull) means node_modules no longer matches it, so install again. Checking only
       that node_modules exists built one line against the other line's backoffice. -->
  <Target Name="RestoreClientPackages" BeforeTargets="BuildClient" Condition="'$(SkipClientBuild)' != 'true'"
          Inputs="$(ClientDir)\package-lock.json" Outputs="$(ClientDir)\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(ClientDir)" Command="npm ci" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="PrepareForBuild" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="$(ClientDir)" Command="npm run build" />
    <!-- wwwroot was globbed at evaluation, before npm ran (and emptied it): drop the chunks that are gone (a changed hash),
         then add the fresh output, so both incremental and clean builds see exactly what npm wrote. A wildcard Remove would
         not work here: inside a target it is matched against the disk, where the stale files no longer exist. -->
    <ItemGroup>
      <Content Remove="@(Content)" Condition="!Exists('%(Content.FullPath)')" />
      <Content Include="wwwroot\App_Plugins\Transfr\**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>