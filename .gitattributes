# Normalise line endings in the index; working files get CRLF
# (house convention, see .editorconfig). Keeps diffs clean across platforms.
* text=auto eol=crlf

# Files that must keep LF.
*.sh text eol=lf

# Code generators (e.g. ModelsBuilder) write these with LF and rewrite them on every generation.
# Without this the global rule checks them out as CRLF, so the file on disk and the file the tool
# writes disagree on every line.
*.generated.cs text eol=lf

# Umbraco regenerates its JSON schemas on build and writes them with LF, exactly like ModelsBuilder.
# Without this they show as modified in every status without a single changed character.
# Remove both lines in a repo without Umbraco.
*-schema*.json text eol=lf
umbraco-package-schema.json text eol=lf

# Binaries: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.dll binary
*.pfx binary

# Generated files: keep out of diffs and language statistics.
*.generated.cs linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
packages.lock.json linguist-generated=true -diff
# Generated OpenAPI client (regenerated by npm run generate-client).
src/Neirijnck.Transfr/Client/src/api/** text eol=lf linguist-generated=true -diff