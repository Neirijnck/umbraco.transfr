<Project>

  <!--
    Central Package Management: package versions live here, never in the .csproj files.
    Transitive pinning lets us patch a vulnerable package we only pull in indirectly (security pins group).
    No floating versions: they contradict packages.lock.json. The package's Umbraco dependencies use
    version ranges instead; a range becomes the NuGet dependency range and restore resolves its minimum.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageFloatingVersionsEnabled>false</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <!--
    Package dependencies. Built and verified against 18.2.1, the minimum of the range; any 18.x from
    there on is supported. Umbraco 17 is the 17.x line on feature/17.
  -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.2.1,19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.2.1,19.0.0)" />
  </ItemGroup>

  <!-- Test site: exactly the version the package is verified against. -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="18.2.1" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="18.2.1" />
    <!-- Must match UmbracoAppLocalIcuVersion in the test site's .csproj. -->
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <!--
    Test dependencies: xUnit + NSubstitute on VSTest, JUnit logger for CI test tabs.
    Newest stable versions, read from the nuget.org flat container on 2026-10-13.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="JunitXml.TestLogger" Version="8.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!--
    Transitive pins for security advisories: each with a comment naming the advisory and the package
    that drags it in; removed once upstream ships the fix.
    Not pinned: SixLabors.ImageSharp 3.1.12 (via Umbraco.Cms, test site only; the package does not depend
    on it) has GHSA-gwg2-r3hj-4w44, -wmxv-xphr-5c9g, -j3p4-wp97-rph4, -j9gm-c75j-xc9q, -jjfr-hcj7-qf5w.
    The first patched version is 4.1.2, a major Umbraco does not support (18.2.1 still asks for 3.1.12), so
    they stay visible as audit warnings until Umbraco ships a fix.
  -->
  <ItemGroup>
    <!--
      GHSA-846f-f764-76mx (CVE-2026-84008, high) and GHSA-2fmv-rv2c-59x7 (CVE-2026-70162, moderate): denial of
      service in 10.0.0 up to 10.0.12. Dragged in by MimeKit (via Umbraco) and System.Security.Cryptography.Xml.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      GHSA-r955-8q5j-3h83 (CVE-2026-96958, high) and GHSA-c399-9853-6jmj (CVE-2026-96959, high): denial of service
      in 10.0.0 up to 10.0.12. Dragged in by
      Umbraco.Cms.Api.Management, Umbraco.Cms.Web.Website and Microsoft.AspNetCore.DataProtection.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>